# The Assay server alone (no browsers): the image the hosted service runs.
#   docker build -t assay-server -f deploy/Dockerfile.server .
#   docker run -p 8080:8080 -v assay-data:/data assay-server --public-url https://assay.example.com
FROM python:3.13-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /opt/assay
COPY pyproject.toml README.md ./
COPY assay ./assay
RUN pip install . && useradd --system --uid 10001 assay && mkdir /data && chown assay /data
USER assay
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/api/health', timeout=4)"
ENTRYPOINT ["assay", "server", "--host", "0.0.0.0", "--port", "8080", "--data", "/data"]
