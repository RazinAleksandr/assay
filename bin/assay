#!/bin/sh
# `assay` in Claude Code: the plugin's bin/ is on the PATH of Claude's shell.
# Runs the scanner bundled in dist/ with uv; the first call sets up its environment (a few seconds), later calls reuse it.
here=$(cd "$(dirname "$0")/.." && pwd)
whl=$(ls "$here"/dist/assay-*-py3-none-any.whl 2>/dev/null | tail -n 1)
if [ -z "$whl" ]; then
  echo "assay: the scanner is missing from $here/dist; reinstall the plugin" >&2
  exit 3
fi
if ! command -v uvx >/dev/null 2>&1; then
  echo "assay: needs uv. Install it with: curl -LsSf https://astral.sh/uv/install.sh | sh" >&2
  exit 3
fi
exec uvx --quiet --from "$whl" assay "$@"
