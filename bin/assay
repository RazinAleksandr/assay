#!/bin/sh
# `assay` in Claude Code: the plugin's bin/ is on the PATH of Claude's shell.
# The plugin is this whole repository, so the scanner runs from its own source with uv: the first call builds it and
# sets up its environment (a few seconds), later calls reuse it until the code changes.
here=$(cd "$(dirname "$0")/.." && pwd)
if ! command -v uvx >/dev/null 2>&1; then
  echo "assay: needs uv. Install it with: curl -LsSf https://astral.sh/uv/install.sh | sh" >&2
  exit 3
fi
if [ ! -f "$here/pyproject.toml" ]; then
  echo "assay: the scanner's source is missing from $here; reinstall the plugin" >&2
  exit 3
fi
exec uvx --quiet --from "$here" assay "$@"
